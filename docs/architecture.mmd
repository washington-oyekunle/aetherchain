    classDef core fill:#173b35,stroke:#6fc7a2,color:#fff;
    classDef data fill:#4a2f19,stroke:#e2a866,color:#fff;
    class RPCClient,Peer,Operator boundary;
    class Chain,Block,State,Mempool,Crypto,Ledger core;
    class Wallet,RPC,P2P,Storage,NodeRuntime data;
